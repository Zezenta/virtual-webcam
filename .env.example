# Configuración de red para Virtual Webcam Hub
# Copia este archivo a .env y ajusta los valores a tu red local

# IP de tu iPhone / Android con DroidCam
PHONE_IP=192.168.0.100

# Puerto de DroidCam en el teléfono (por defecto 4747)
PHONE_PORT=4747

# Puerto local donde escucha el servidor webhook en la PC (por defecto 8899)
PORT=8899

# Dispositivo virtual V4L2
DEV=/dev/video0
